# Public base URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator wallet — set as the coin's platformReferrer → earns ~20% of every
# coin's trade fees, forever. This is the money line.
NEXT_PUBLIC_REFERRER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: a Base RPC for the client (defaults to the public Base RPC)
NEXT_PUBLIC_BASE_RPC_URL=

# Optional: Zora API key (raises rate limits when assembling the create call)
NEXT_PUBLIC_ZORA_API_KEY=

# Metadata storage (priority: REDIS_URL > Upstash > in-memory dev-only)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Farcaster manifest account association (sign once with the manifest tool)
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=
